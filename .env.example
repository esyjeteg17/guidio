# --- Django ---
DEBUG=False
SECRET_KEY=replace-me-with-long-random-string
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost

# --- Database ---
DB_NAME=guidio-db
DB_USER=postgres
DB_PASSWORD=postgres

# --- AI / внешние сервисы ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
PEXELS_API_KEY=
SONIOX_API_KEY=

# --- Эмбеддинги ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# --- Публичный порт HTTP ---
HTTP_PORT=80

# --- Frontend build-time ---
# SPA ходит на тот же origin через nginx-проксю, поэтому относительный путь.
NUXT_PUBLIC_API_BASE=/api
